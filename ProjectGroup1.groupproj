<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{27889A3D-3793-4AAC-8AF8-E9089B2176B1}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="VclVLC.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="FmxVLC.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="VclVLC">
        <MSBuild Projects="VclVLC.dproj"/>
    </Target>
    <Target Name="VclVLC:Clean">
        <MSBuild Projects="VclVLC.dproj" Targets="Clean"/>
    </Target>
    <Target Name="VclVLC:Make">
        <MSBuild Projects="VclVLC.dproj" Targets="Make"/>
    </Target>
    <Target Name="FmxVLC">
        <MSBuild Projects="FmxVLC.dproj"/>
    </Target>
    <Target Name="FmxVLC:Clean">
        <MSBuild Projects="FmxVLC.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FmxVLC:Make">
        <MSBuild Projects="FmxVLC.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="VclVLC;FmxVLC"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="VclVLC:Clean;FmxVLC:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="VclVLC:Make;FmxVLC:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
